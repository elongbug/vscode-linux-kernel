{
    "files.exclude": {
        "**/.*.*.cmd": true,
        "**/.*.d": true,
        "**/.*.S": true,
        "**/cscope.out": true,
        "**/tags": true
    },
    "[c]": {
        "editor.detectIndentation": false,
        "editor.tabSize": 8,
        "editor.insertSpaces": false,
        "editor.rulers": [80]
    },
    "files.associations": {
        "*.h": "c",
        "array": "c",
        "chrono": "c",
        "compare": "c",
        "functional": "c",
        "istream": "c",
        "ostream": "c",
        "ratio": "c",
        "tuple": "c",
        "type_traits": "c",
        "utility": "c",
        "memory": "c",
        "semaphore": "c",
        "shared_mutex": "c",
        "stop_token": "c",
        "condition_variable": "c",
        "random": "c",
        "limits": "c",
        "valarray": "c",
        "*.inc": "c",
        "atomic": "c",
        "cstdint": "c",
        "*.tcc": "c",
        "*.def": "c",
        "string": "c",
        "string_view": "c",
        "hash_map": "c",
        "bitset": "c",
        "initializer_list": "c",
        "optional": "c",
        "system_error": "c",
        "variant": "c",
        "typeindex": "cpp",
        "typeinfo": "cpp",
        "hash_set": "c",
        "numbers": "c"
    },
    //global variable color setting
    "editor.semanticTokenColorCustomizations": {
        "enabled": true,
        "rules": {
            "*.declaration": { "bold": true },
            "variable.global": {
                "foreground": "#9932cc", // violet
                //"foreground": "#800000", // maroon
                //"fontStyle": "italic bold underline"
                "fontStyle": "italic"
            }
        }
    },
    "C_Cpp.errorSquiggles": "Disabled"
}
