{
    "files.exclude": {
        "**/.*.*.cmd": true,
        "**/.*.d": true,
        "**/.*.S": true,
        "**/cscope.out": true,
        "**/tags": true
    },
    "[c]": {
        "editor.detectIndentation": false,
        "editor.tabSize": 8,
        "editor.insertSpaces": false,
        "editor.rulers": [80],
        "editor.links": false
    },
    "files.associations": {
        "*.h": "c",
        "array": "c",
        "chrono": "c",
        "compare": "c",
        "functional": "c",
        "istream": "c",
        "ostream": "c",
        "ratio": "c",
        "tuple": "c",
        "type_traits": "c",
        "utility": "c",
        "memory": "c",
        "semaphore": "c",
        "shared_mutex": "c",
        "stop_token": "c",
        "condition_variable": "c",
        "random": "c",
        "limits": "c",
        "valarray": "c",
        "*.inc": "c",
        "atomic": "c",
        "cstdint": "c",
        "*.tcc": "c",
        "*.def": "c",
        "string": "c",
        "string_view": "c",
        "hash_map": "c",
        "bitset": "c",
        "initializer_list": "c",
        "optional": "c",
        "system_error": "c",
        "variant": "c",
        "typeindex": "cpp",
        "typeinfo": "cpp",
        "hash_set": "c",
        "numbers": "c",
        "memory_resource": "c",
        "__node_handle": "c",
        "bit": "c",
        "__bit_reference": "c",
        "__functional_base": "c",
        "algorithm": "c",
        "deque": "c",
        "__memory": "c",
        "filesystem": "c",
        "iterator": "c",
        "locale": "c",
        "vector": "c",
        "__functional_base_03": "c",
        "__hash_table": "c",
        "__tree": "c",
        "__tuple": "c",
        "forward_list": "c",
        "iosfwd": "c",
        "streambuf": "c",
        "__locale": "c",
        "queue": "c",
        "stack": "c",
        "mutex": "c",
        "__mutex_base": "c"
    },
    //global variable color setting
    "editor.semanticTokenColorCustomizations": {
        "enabled": true,
        "rules": {
            //"*.declaration": { "bold": true },
            // MS cpptools lsp
            "variable.global": {
                "foreground": "#9932cc", // violet
                //"foreground": "#800000", // maroon
                //"fontStyle": "italic bold underline"
                "fontStyle": "italic"
            }
            // clangd lsp
            "variable.globalScope": {
                "foreground": "#9932cc", // violet
                "fontStyle": "italic"
            }
        }
    },
    "editor.stickyScroll.enabled": false,
    "C_Cpp.errorSquiggles": "Disabled"
}
